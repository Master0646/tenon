{
  "name": "devflow",
  "version": "0.3.0",
  "private": true,
  "description": "规范驱动、带项目长期知识的 AI 软件工程内核（嵌入现有 Agent 使用）",
  "type": "module",
  "bin": {
    "devflow": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "vendor",
    "README.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "docs:html": "node scripts/build-manual-html.mjs",
    "prepack": "npm run -s build",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
